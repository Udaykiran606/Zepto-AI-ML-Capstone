"""Data_Pipeline.py

Module 1 — Data Pipeline (books.toscrape.com)
Scrape -> Clean -> Convert -> Store -> Query -> Validate
"""

import sqlite3
import time
from bs4 import BeautifulSoup
import numpy as np
import pandas as pd
import requests

# 1. Setup constants
BASE_URL = "http://books.toscrape.com/"
GBP_TO_INR_RATE = 105.50
DB_NAME = "catalog_pipeline.db"


def get_soup(url):
    """Helper function to fetch and parse web pages safely."""
    response = requests.get(url)
    response.raise_for_status()
    response.encoding = "utf-8"
    return BeautifulSoup(response.text, "html.parser")


def scrape_category_books(category_url, category_name, all_books_data):
    """Scrapes all books from a given category and handles multi-page navigation."""
    current_url = category_url

    while current_url:
        print(f"-> Visiting page: {current_url}")
        soup = get_soup(current_url)
        books = soup.find_all("article", class_="product_pod")

        for book in books:
            title_elem = book.h3.a
            title = title_elem["title"] if title_elem else None

            price_elem = book.find("p", class_="price_color")
            price_raw = price_elem.text.strip() if price_elem else None

            rating_p = book.find("p", class_="star-rating")
            star_rating_raw = rating_p["class"][1] if rating_p else None

            avail_elem = book.find("p", class_="instock availability")
            availability_raw = avail_elem.text.strip() if avail_elem else None

            all_books_data.append({
                "title": title,
                "price_raw": price_raw,
                "star_rating_raw": star_rating_raw,
                "availability_raw": availability_raw,
                "category": category_name,
            })

        next_button = soup.find("li", class_="next")
        if next_button and next_button.find("a"):
            next_page_relative = next_button.find("a")["href"]
            current_url = requests.compat.urljoin(current_url, next_page_relative)
        else:
            current_url = None

        time.sleep(0.3)


def clean_and_transform_data(df):
    """Cleans text values, fills missing data using medians, and adds INR currency conversion."""
    print("\n--- Starting Data Cleaning & Transformation ---")

    # Drop missing titles
    df = df.dropna(subset=["title"])
    df["category"] = df["category"].str.strip().str.lower()

    # Clean price
    def parse_price(val):
        try:
            cleaned = str(val).replace("£", "").replace("Â£", "").strip()
            return float(cleaned)
        except (ValueError, TypeError):
            return np.nan

    df["price_gbp"] = df["price_raw"].apply(parse_price)
    price_median = df["price_gbp"].median()
    df["price_gbp"] = df["price_gbp"].fillna(price_median)

    # Convert currency
    df["price_inr"] = round(df["price_gbp"] * GBP_TO_INR_RATE, 2)

    # Clean star rating
    rating_map = {"One": 1, "Two": 2, "Three": 3, "Four": 4, "Five": 5}
    df["rating"] = df["star_rating_raw"].apply(lambda x: rating_map.get(x, np.nan))
    rating_median = df["rating"].median()
    df["rating"] = df["rating"].fillna(rating_median).astype(int)

    # Clean availability
    df["in_stock"] = df["availability_raw"].apply(
        lambda val: True if pd.notna(val) and "in stock" in str(val).lower() else False
    )

    return df[["title", "price_gbp", "price_inr", "rating", "in_stock", "category"]].copy()


def load_to_sqlite(df):
    """Saves the cleaned data into a 2-table SQLite relational database."""
    print(f"\n--- Loading Data into SQLite ({DB_NAME}) ---")

    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()

        cursor.execute("DROP TABLE IF EXISTS books")
        cursor.execute("DROP TABLE IF EXISTS categories")

        cursor.execute("""
            CREATE TABLE categories (
                category_id INTEGER PRIMARY KEY AUTOINCREMENT,
                category_name TEXT UNIQUE NOT NULL
            )
        """)

        cursor.execute("""
            CREATE TABLE books (
                book_id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                price_gbp REAL NOT NULL,
                price_inr REAL NOT NULL,
                rating INTEGER NOT NULL,
                in_stock INTEGER NOT NULL,
                category_id INTEGER,
                FOREIGN KEY (category_id) REFERENCES categories(category_id)
            )
        """)

        # Insert categories
        unique_categories = df["category"].unique()
        category_id_map = {}

        for cat_name in unique_categories:
            cursor.execute("INSERT OR IGNORE INTO categories (category_name) VALUES (?)", (cat_name,))
            cursor.execute("SELECT category_id FROM categories WHERE category_name = ?", (cat_name,))
            cat_id = cursor.fetchone()[0]
            category_id_map[cat_name] = cat_id

        # Insert books
        for _, row in df.iterrows():
            cat_id = category_id_map[row["category"]]
            in_stock_int = 1 if row["in_stock"] else 0

            cursor.execute(
                """
                INSERT INTO books (title, price_gbp, price_inr, rating, in_stock, category_id)
                VALUES (?, ?, ?, ?, ?, ?)
                """,
                (row["title"], row["price_gbp"], row["price_inr"], row["rating"], in_stock_int, cat_id),
            )

        conn.commit()
    print("✅ Successfully saved into SQLite Database!")


def run_queries_and_validation():
    """Runs required SQL queries and verifies outputs using Pandas."""
    print("\n--- Executing SQL Queries & Validations ---")

    with sqlite3.connect(DB_NAME) as conn:
        # 1. SELECT / WHERE
        df_where = pd.read_sql("SELECT title, price_gbp FROM books WHERE rating = 5 AND in_stock = 1", conn)
        print("\n[Query 1: SELECT/WHERE] 5-star books in stock:")
        print(df_where.head(3))

        # 2. ORDER BY & LIMIT
        df_order = pd.read_sql("SELECT title, price_inr FROM books ORDER BY price_inr DESC LIMIT 5", conn)
        print("\n[Query 2: ORDER BY & LIMIT] Top 5 expensive books in INR:")
        print(df_order)

        # 3. DISTINCT
        df_distinct = pd.read_sql("SELECT DISTINCT rating FROM books ORDER BY rating DESC", conn)
        print("\n[Query 3: DISTINCT] Ratings found:")
        print(df_distinct)

        # 4. BETWEEN
        df_between = pd.read_sql("SELECT title, price_gbp FROM books WHERE price_gbp BETWEEN 20.0 AND 40.0", conn)
        print("\n[Query 4: BETWEEN] Books between £20 and £40:")
        print(df_between.head(3))

        # 5. JOIN
        query_join = """
            SELECT b.title, c.category_name, b.price_gbp, b.rating
            FROM books b
            JOIN categories c ON b.category_id = c.category_id
            ORDER BY b.rating DESC, b.price_gbp ASC
        """
        df_sql_join = pd.read_sql(query_join, conn)
        print("\n[Query 5: JOIN] Books combined with Category Names:")
        print(df_sql_join.head(3))

        # Compare SQL JOIN with Pandas merge
        df_books = pd.read_sql("SELECT * FROM books", conn)
        df_cats = pd.read_sql("SELECT * FROM categories", conn)

        df_pd_merged = pd.merge(df_books, df_cats, on="category_id", how="inner")
        df_pd_merged = df_pd_merged[["title", "category_name", "price_gbp", "rating"]]
        df_pd_merged = df_pd_merged.sort_values(by=["rating", "price_gbp"], ascending=[False, True]).reset_index(drop=True)

        are_equal = df_sql_join.reset_index(drop=True).equals(df_pd_merged)
        print(f"\n✅ Do SQL JOIN and Pandas merge match? {are_equal}")


def main():
    print("--- Starting Pipeline ---")
    main_soup = get_soup(BASE_URL)
    sidebar = main_soup.find("div", class_="side_categories")
    category_links = sidebar.ul.ul.find_all("a")

    # Scrape 8 categories (ensures >= 60 books requirement is met)
    target_categories = category_links[:8]
    all_books_data = []

    for cat in target_categories:
        cat_name = cat.text.strip()
        cat_url = requests.compat.urljoin(BASE_URL, cat["href"])
        print(f"\nScraping Category: {cat_name}")
        scrape_category_books(cat_url, cat_name, all_books_data)

    raw_df = pd.DataFrame(all_books_data)
    print(f"\n🎉 Total books collected: {len(raw_df)}")

    final_df = clean_and_transform_data(raw_df)
    final_df.to_csv("scraped_books_cleaned.csv", index=False)

    load_to_sqlite(final_df)
    run_queries_and_validation()


if __name__ == "__main__":
    main()